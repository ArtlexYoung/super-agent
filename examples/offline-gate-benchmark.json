{
  "schema_version": 2,
  "agents": [{
    "name": "super-agent-offline",
    "version": "0.1",
    "command": ["{python}", "{project_root}/src/cli.py", "--output", "json", "{prompt}"],
    "environment": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "{project_root}/src",
      "SUPER_AGENT_PROVIDER": "mock"
    },
    "result_json_field": "text"
  }],
  "tasks": [{
    "id": "stateless-runtime",
    "prompt": "Return the offline test response.",
    "workspace": null,
    "checks": {
      "output_contains": ["Mock response"],
      "output_excludes": ["failed"],
      "files": [],
      "workspace_unchanged": true
    }
  }]
}
